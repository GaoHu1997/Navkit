+    protect_saved_export_path(state, &opts.file)?;
+    let types = set.types();
+    let result = tokio::task::spawn_blocking(move || {
+        crate::transfer::export_spool_set(&set, &opts, &kind, &names, &types)
+    })
+    .await
+    .map_err(|e| AppError::new(format!("导出任务意外结束：{e}")))?;
