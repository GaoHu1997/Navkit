+/// MongoDB：由文档页推导表结构。
+async fn mongo_table_schema(
+    m: &crate::mongo_db::MongoDb,
+    kind: DbKind,
+    schema: &str,
+    table: &str,
+) -> Result<TableSchema> {
+    let (cols, _) = m.find_docs(schema, table, "", 0, 20).await?;
+    let mut out = TableSchema {
+        table: table.to_string(),
+        database: schema.to_string(),
+        columns: Vec::new(),
+        indexes: Vec::new(),
+        foreign_keys: Vec::new(),
+        comment: None,
+        engine: None,
+        collation: None,
+        row_count: None,
+    };
+    for name in cols {
+        let pk = name == "_id";
+        out.columns.push(ColumnInfo {
+            name,
+            data_type: "string".to_string(),
+            nullable: true,
+            default: None,
+            primary_key: pk,
+            auto_increment: false,
+            comment: None,
+            length: None,
+            precision: None,
+            scale: None,
+        });
+    }
+    let cnt = m.count(schema, table, "").await?;
+    out.row_count = Some(cnt as i64);
+    let _ = kind;
+    Ok(out)
+}
