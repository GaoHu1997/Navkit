+            .get_json(&format!("/api/queues/{}", urlencode(container)))
+            .await?;
+        Ctx::check(s, &j, "RabbitMQ 列队列")?;
+        for q in j.as_array().cloned().unwrap_or_default() {
+            if let Some(n) = q.get("name").and_then(jtext) {
