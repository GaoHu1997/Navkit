+  limitations: string[];
+}
+
+export interface TableDesignReceipt extends DesignReceipt {
+  snapshot: TableDesignSnapshot | null;
+}
+
+/** 唯有 outcome succeeded + receipt verified && !unverified && 无 mismatch 才能展示成功。 */
+export interface TableDesignResponse {
