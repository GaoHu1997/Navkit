-/// 连接附加参数：`k=v;k=v` 或 `k=v&k=v` 形式。
-pub fn extra_params(params: &str) -> Vec<(String, String)> {
-    let mut out = Vec::new();
-    for pair in params.split(['&', ';']) {
-        let pair = pair.trim();
-        if pair.is_empty() {
-            continue;
-        }
-        if let Some((k, v)) = pair.split_once('=') {
-            let (k, v) = (k.trim().to_string(), v.trim().to_string());
-            if !k.is_empty() {
-                out.push((k, v));
-            }
-        }
-    }
-    out
-}
