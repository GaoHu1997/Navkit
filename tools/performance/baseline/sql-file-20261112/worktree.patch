+/// HTTP 类数据源：优先用适配器真实列元数据（如 JDBC），否则由前几行数据推导。
+async fn http_table_schema(
+    h: &crate::http_db::HttpDb,
+    kind: DbKind,
+    schema: &str,
+    table: &str,
+) -> Result<TableSchema> {
+    let mut out = TableSchema {
+        table: table.to_string(),
+        database: schema.to_string(),
+        columns: Vec::new(),
+        indexes: Vec::new(),
+        foreign_keys: Vec::new(),
+        comment: None,
+        engine: None,
+        collation: None,
+        row_count: None,
+    };
+    if let Some(columns) = h.table_columns(schema, table).await? {
+        for col in columns {
+            out.columns.push(ColumnInfo {
+                name: col.name,
+                data_type: col.data_type,
+                nullable: col.nullable,
+                default: None,
+                primary_key: col.primary_key,
+                auto_increment: false,
+                comment: None,
+                length: None,
+                precision: None,
+                scale: None,
+            });
+        }
+    } else {
+        let r = h.rows(schema, table, 0, 20).await?;
+        for name in r.columns {
+            out.columns.push(ColumnInfo {
+                name,
+                data_type: "string".to_string(),
+                nullable: true,
+                default: None,
+                primary_key: false,
+                auto_increment: false,
+                comment: None,
+                length: None,
+                precision: None,
+                scale: None,
+            });
+        }
+    }
+    let _ = kind;
+    Ok(out)
+}
