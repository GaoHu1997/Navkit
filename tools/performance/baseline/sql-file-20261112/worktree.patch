+    );
+    head.appendChild(titles);
+
+    const reason = node("div", "drv-reason");
+    reason.append(
+      node("div", "drv-reason-title", "为什么不能自动下载"),
+      node("div", "drv-reason-text", (row?.message || "该数据源没有可用的官方直链，需要从厂商渠道获取。").split("\n")[0]),
