+      }
+    }
+  };
+
+  // —— 渲染：右侧详情 ——
+  const versionRow = (row: DatabaseDriverStatus, recommended: boolean): HTMLElement => {
+    const key = versionKey(row);
+    const entry = activity.get(key);
+    const holders = refs.byVersion.get(key) ?? [];
+    const line = node("div", "drv-vrow");
