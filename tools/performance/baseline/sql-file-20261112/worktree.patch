-                let dflt = vals.get(4).cloned().flatten();
-                let pk = vals
-                    .get(5)
-                    .cloned()
-                    .flatten()
-                    .and_then(|v| v.parse::<i64>().ok())
-                    .unwrap_or(0);
-                columns.push(ColumnInfo {
-                    name: name.clone(),
-                    data_type: ctype,
-                    nullable: notnull == 0,
-                    default: dflt,
-                    primary_key: pk > 0,
-                    auto_increment: false,
-                    comment: None,
-                    length: None,
-                    precision: None,
-                    scale: None,
