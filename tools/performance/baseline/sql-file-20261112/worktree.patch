+        assert!(valid_daily_at("00:00"));
+        assert!(valid_daily_at("9:05"));
+        assert!(valid_daily_at("23:59"));
+        assert!(!valid_daily_at("24:00"));
+        assert!(!valid_daily_at("12:60"));
+        assert!(!valid_daily_at("12:5"));
+        assert!(!valid_daily_at("noon"));
+    }
