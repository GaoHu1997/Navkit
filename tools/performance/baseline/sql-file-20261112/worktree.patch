+fn mysql_table_status_sql(kind: &DbKind, schema: &str, table: &str) -> String {
+    format!("SHOW TABLE STATUS FROM {} WHERE Name = {}", quote_ident(kind, schema), crate::db::quote_literal(table))
+}
