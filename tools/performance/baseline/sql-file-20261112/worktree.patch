+/// Redis：单键数据页。
+async fn redis_key_page(r: &crate::redis_db::RedisDb, req: &PageRequest) -> Result<PageResult> {
+    let dbn = req
+        .schema
+        .strip_prefix("db")
+        .and_then(|n| n.parse::<i64>().ok())
+        .unwrap_or(0);
+    let (ty, ttl, value) = r.key_info(dbn, &req.table).await?;
+    Ok(PageResult {
+        columns: vec![
+            ResultColumn {
+                name: "key".into(),
+                data_type: "string".into(),
+                nullable: false,
+                primary_key: true,
+                auto_increment: false,
+            },
+            ResultColumn {
+                name: "type".into(),
+                data_type: "string".into(),
+                nullable: false,
+                primary_key: false,
+                auto_increment: false,
+            },
+            ResultColumn {
+                name: "ttl".into(),
+                data_type: "int".into(),
+                nullable: true,
+                primary_key: false,
+                auto_increment: false,
+            },
+            ResultColumn {
+                name: "value".into(),
+                data_type: "string".into(),
+                nullable: true,
+                primary_key: false,
+                auto_increment: false,
+            },
+        ],
+        rows: vec![vec![
+            Some(req.table.clone()),
+            Some(ty),
+            Some(ttl.to_string()),
+            Some(value),
+        ]],
+        total: 1,
+        primary_keys: vec!["key".into()],
+        elapsed_ms: 0,
+    })
+}
