+// ---------------------------------------------------------------------------
+// 自定义驱动：单页表单（原来是三步向导，步骤本身没有价值）
+// ---------------------------------------------------------------------------
+
+/** 打开自定义驱动编辑页；保存/删除后把最新列表交回调用方。 */
+export function openCustomDriverDialog(
+  onChanged?: (drivers: DriverDefinition[]) => void,
+  focusId?: string,
+): Dialog {
+  let drivers: DriverDefinition[] = [];
