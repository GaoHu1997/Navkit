+        .ok_or_else(|| anyhow!("当前应用架构中没有安装该 ODBC 驱动：{name}"))?;
+    let path = driver_path(&driver.library).ok_or_else(|| anyhow!("已安装 ODBC 驱动的主库路径无效：{name}"))?;
