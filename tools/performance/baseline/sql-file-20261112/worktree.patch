-        if statement.iter().any(|t| matches!(t.as_str(), "BEGIN" | "COMMIT" | "ROLLBACK" | "SAVEPOINT" | "RELEASE" | "START" | "ATTACH" | "DETACH" | "USE" | "LOCK" | "UNLOCK" | "CREATE" | "ALTER" | "DROP" | "TRUNCATE" | "GRANT" | "REVOKE" | "CALL" | "VACUUM" | "PRAGMA")) {
