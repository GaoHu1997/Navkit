+        "Content-Length",
+        "Content-Type",
+        "Accept-Encoding",
+        "If-Match",
+        "If-None-Match",
+        "Depth",
+        "Destination",
+        "Overwrite",
+        "Range",
+        "Connection",
+        "Transfer-Encoding",
+    ] {
+        assert!(webdav::parse_headers(&format!("{name}: override")).is_err());
+    }
