+            None => ("queue", object),
+        };
+        let (s, j) = self
+            .ctx
+            .get_json(&format!(
+                "/api/{}/{}/{}",
+                if kind == "exchange" { "exchanges" } else { "queues" },
+                urlencode(container),
+                urlencode(name)
+            ))
+            .await?;
+        Ctx::check(s, &j, "RabbitMQ 详情")?;
+        // 竖排展示：metric / value
+        let mut rows = Vec::new();
+        if let Value::Object(map) = &j {
+            for (k, v) in map {
