-            let def = rows
-                .first()
-                .and_then(|r| crate::values::pg_row_values(r, 1).first().cloned().flatten())
-                .unwrap_or_default();
-            if def.is_empty() {
-                return Err(anyhow::anyhow!("视图不存在"));
-            }
-            Ok(format!(
-                "CREATE OR REPLACE VIEW {} AS {}",
-                full,
-                def.trim_end_matches(';').trim()
