+  private renderTable(): void {
+    const s = this.tableState;
+    const key = JSON.stringify([s, this.tableMode]);
+    if (key === this.lastTableKey) return;
+    this.lastTableKey = key;
+    const scrollTop = this.body.scrollTop;
+    this.body.innerHTML = "";
