+            .map(|groups: Vec<Vec<DriverStatus>>| groups.into_iter().flatten().collect())
+            .map_err(|error| error.to_string())?;
+        store_driver_statuses(fingerprint, &statuses);
+        Ok(statuses)
+    }).await.map_err(|error| error.to_string())?
