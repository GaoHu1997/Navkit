-        if in_line_comment {
-            cur.push(c);
-            if c == '\n' {
-                in_line_comment = false;
-            }
-            continue;
-        }
-        if in_block_comment {
-            cur.push(c);
-            if c == '*' && chars.peek() == Some(&'/') {
-                cur.push(chars.next().unwrap());
-                in_block_comment = false;
-            }
-            continue;
-        }
-        if in_str {
-            cur.push(c);
-            if c == quote {
-                if chars.peek() == Some(&'\'') {
-                    cur.push(chars.next().unwrap());
-                } else {
-                    in_str = false;
-                }
-            }
-            continue;
-        }
-        match c {
-            '\'' | '"' | '`' => {
-                in_str = true;
-                quote = c;
-                cur.push(c);
-            }
-            '-' if chars.peek() == Some(&'-') => {
-                in_line_comment = true;
-                cur.push(c);
-            }
-            '/' if chars.peek() == Some(&'*') => {
-                in_block_comment = true;
-                cur.push(c);
-            }
-            ';' => {
-                out.push(std::mem::take(&mut cur));
-            }
-            _ => cur.push(c),
-        }
-    }
-    if !cur.trim().is_empty() {
-        out.push(cur);
-    }
-    out
-}
