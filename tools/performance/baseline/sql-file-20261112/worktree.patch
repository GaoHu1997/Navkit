-                .generic_rows(&format!("SHOW CREATE TABLE {}", full))
-                .await?;
-            rows.first()
-                .and_then(|r| r.first().cloned().flatten())
-                .filter(|s| !s.is_empty())
-                .ok_or_else(|| anyhow::anyhow!("视图不存在"))
-        }
-        "hive" | "inceptor" | "argodb" | "spark" | "impala" | "kyuubi" => {
-            let full = crate::db::qualified(&kind, schema, view);
