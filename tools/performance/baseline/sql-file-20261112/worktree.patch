+/// 列出某连接某数据库下的备份文件。
+#[tauri::command]
+pub fn list_backups(connection_id: String, schema_name: String) -> CmdResult<Vec<BackupInfo>> {
+    let dir = storage::backup_dir(&connection_id, &schema_name);
+    let mut out = Vec::new();
+    if let Ok(rd) = std::fs::read_dir(&dir) {
+        for e in rd.flatten() {
+            let p = e.path();
+            if !p.is_file() {
+                continue;
+            }
+            let name = p.file_name().map(|s| s.to_string_lossy().to_string()).unwrap_or_default();
+            if !name.to_ascii_lowercase().ends_with(".sql") {
+                continue;
+            }
+            let meta = e.metadata()?;
+            let modified = meta
+                .modified()
+                .ok()
+                .map(|t| chrono::DateTime::<chrono::Local>::from(t).format("%Y-%m-%d %H:%M:%S").to_string())
+                .unwrap_or_default();
+            // 注释写在文件头 "-- 注释     : xxx"
+            let comment = std::fs::read_to_string(&p)
+                .unwrap_or_default()
+                .lines()
+                .take(12)
+                .find_map(|l| l.trim().strip_prefix("-- 注释"))
+                .map(|s| {
+                    s.trim_start_matches(|c: char| c == ' ' || c == ':' || c == '：')
+                        .trim()
+                        .to_string()
+                })
+                .unwrap_or_default();
+            out.push(BackupInfo {
+                name,
+                modified,
+                size: meta.len(),
+                comment,
+            });
+        }
+    }
+    out.sort_by(|a, b| b.name.cmp(&a.name));
+    Ok(out)
+}
