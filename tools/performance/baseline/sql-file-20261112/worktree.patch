+    expand.type = "button";
+    expand.className = "backup-tree-toggle";
+    expand.style.cssText = "display:flex;align-items:center;gap:8px;flex:1;min-width:0;text-align:left;padding:0;color:inherit;font-weight:inherit;";
+    expand.setAttribute("aria-expanded", "true");
+    expand.setAttribute("aria-label", `折叠${title}`);
+
+    const twisty = document.createElement("span");
+    twisty.className = "backup-tree-twisty";
+    twisty.innerHTML = '<svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>';
+    const ic = document.createElement("span");
+    ic.className = "backup-tree-icon";
+    ic.innerHTML = iconSvgByName(icon);
+    const name = document.createElement("span");
+    name.className = "backup-tree-label";
+    name.textContent = title;
+    const count = document.createElement("span");
+    count.className = "backup-tree-count";
+
+    const toggle = document.createElement("button");
+    toggle.type = "button";
+    toggle.className = "backup-tree-toggle";
+    toggle.hidden = true;
+    toggle.addEventListener("click", (event) => {
+      event.stopPropagation();
+      const allChecked = bucket.items.every((it) => it.input.checked);
+      for (const it of bucket.items) it.input.checked = !allChecked;
+      refreshToggle(bucket);
+    });
+    bucket.toggle = toggle;
+    bucket.count = count;
+
+    expand.append(twisty, ic, name);
+    root.append(expand, count, toggle);
+
+    const children = document.createElement("div");
+    children.className = "backup-tree-children";
+    children.id = `backup-group-${++backupGroupSequence}`;
+    expand.setAttribute("aria-controls", children.id);
+    const empty = document.createElement("div");
+    empty.className = "backup-tree-empty";
+    empty.textContent = "（无）";
+    children.appendChild(empty);
+    bucket.empty = empty;
+    el.append(root, children);
+
+    let collapsed = false;
+    const setCollapsed = (next: boolean): void => {
+      collapsed = next;
+      children.hidden = collapsed;
+      expand.setAttribute("aria-expanded", String(!collapsed));
+      expand.setAttribute("aria-label", `${collapsed ? "展开" : "折叠"}${title}`);
+      root.classList.toggle("is-collapsed", collapsed);
+    };
+    expand.addEventListener("click", () => setCollapsed(!collapsed));
+    return { bucket, el, children, empty };
+  }
+
+  /** 向树分组添加一个叶子勾选行（默认勾选）。 */
+  function addItem(group: BackupGroup, name: string, icon: string): void {
+    const row = document.createElement("label");
+    row.className = "checkbox backup-tree-leaf";
+    const input = document.createElement("input");
+    input.type = "checkbox";
+    input.checked = true;
+    input.setAttribute("aria-label", name);
+    const ic = document.createElement("span");
+    ic.className = "backup-tree-icon";
+    ic.innerHTML = iconSvgByName(icon);
+    const text = document.createElement("span");
+    text.className = "backup-tree-label";
+    text.textContent = name;
+    row.append(input, ic, text);
+    group.children.insertBefore(row, group.empty);
+    group.bucket.items.push({ name, input });
+    input.addEventListener("change", () => refreshToggle(group.bucket));
+  }
+
+  const tree = document.createElement("div");
+  tree.className = "backup-tree";
+  tree.setAttribute("role", "group");
+  tree.setAttribute("aria-label", "选择备份对象");
+  const tablesGroup = makeTreeGroup("表", "info_pane_table", tableBucket);
+  const viewsGroup = makeTreeGroup("视图", "info_pane_view", viewBucket);
+  const routinesGroup = makeTreeGroup("函数与存储过程", "info_pane_function", routineBucket);
+  tree.append(tablesGroup.el, viewsGroup.el, routinesGroup.el);
+
+  /** 加载表 / 视图 / 例程清单（只加载一次，失败可重试）。 */
+  async function loadObjects(): Promise<void> {
+    if (loaded) return;
+    loaded = true;
+    loadStatus.textContent = "正在加载对象列表...";
+    try {
+      const [tables, routines] = await Promise.all([
+        api.listTables(connection.id, schema),
+        api.listRoutines(connection.id, schema),
+      ]);
