-/// 返回剩余 SQL；纯注释返回空串。不碰行内注释与字符串字面量。
-pub fn strip_leading_comments(stmt: &str) -> String {
-    let mut s = stmt.trim_start();
-    loop {
-        if s.starts_with("--") {
-            s = s.split_once('\n').map(|(_, r)| r.trim_start()).unwrap_or("");
-            continue;
-        }
-        if s.starts_with("/*") {
-            match s.find("*/") {
-                Some(i) => s = s[i + 2..].trim_start(),
-                None => return String::new(),
-            }
-            continue;
-        }
-        break;
-    }
-    s.trim().to_string()
-}
