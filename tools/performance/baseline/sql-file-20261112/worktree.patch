+        node("div", "drv-empty-title", "这里还没有内容"),
+        node("div", "drv-muted", "左边可能被筛选条件清空了，也可能当前数据源都由内置协议直连、不需要额外驱动文件。"),
+      );
+      detail.appendChild(empty);
