+            .map_err(AppError::from),
+        "json" => crate::transfer::import_json(db.as_ref(), kind, &opts)
+            .await
+            .map_err(AppError::from),
+        "sql" => crate::transfer::import_sql(db.as_ref(), kind, &opts)
+            .await
+            .map_err(AppError::from),
+        other => Err(AppError::new(format!("不支持的导入格式: {}", other))),
