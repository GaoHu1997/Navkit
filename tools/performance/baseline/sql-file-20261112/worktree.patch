+//! 数据源类型目录：全部支持的数据源类型与其连接协议映射。
+//!
+//! NavKit 的分层支持策略：
+//! - 协议兼容：MySQL / PostgreSQL 协议族数据库直接复用对应原生驱动；
+//! - 原生客户端：SQL Server、Redis、MongoDB、HTTP API 类（检索 / 向量 / 时序 / MQ）；
+//! - ODBC 通用：提供 Windows ODBC 驱动的数据源（Oracle、DB2、达梦、Hive 等）。
+//!
+//! 新增一种数据源只需在 `CATALOG` 表中加一行；前端通过 `db_kinds` 命令读取。
+
+use crate::models::Protocol;
+
+/// 单个数据源类型的元信息。
+pub struct KindMeta {
+    /// 目录 id（连接配置中的 kind 字符串，小写）。
+    pub id: &'static str,
+    /// 显示名。
+    pub label: &'static str,
+    /// 默认端口。
+    pub port: u16,
+    /// 连接协议族。
+    pub protocol: Protocol,
+    /// 分类 id：relational / analytics / domestic / lightweight / nosql / graph /
+    /// timeseries / mq / registry。
+    pub category: &'static str,
+    /// HTTP 适配器 id（仅 Protocol::Http 使用，其余为空）。
+    pub http: &'static str,
+    /// ODBC 驱动名提示（仅 Protocol::Odbc 使用，空表示需在参数中提供 DSN / 连接串）。
+    pub driver: &'static str,
+    /// 连接说明（驱动要求 / 额外参数提示）。
+    pub note: &'static str,
+    /// true 表示适配器尚未提供，仅可浏览目录，连接时会给出明确提示。
+    pub planned: bool,
+}
+
+const fn k(
+    id: &'static str,
+    label: &'static str,
+    port: u16,
+    protocol: Protocol,
+    category: &'static str,
+) -> KindMeta {
+    KindMeta {
+        id,
+        label,
+        port,
+        protocol,
+        category,
+        http: "",
+        driver: "",
+        note: "",
+        planned: false,
+    }
+}
+
+const fn odbc(
+    id: &'static str,
+    label: &'static str,
+    port: u16,
+    category: &'static str,
+    driver: &'static str,
+    note: &'static str,
+) -> KindMeta {
+    KindMeta {
+        id,
+        label,
+        port,
+        protocol: Protocol::Odbc,
+        category,
+        http: "",
+        driver,
+        note,
+        planned: false,
+    }
+}
+
+const fn http(
+    id: &'static str,
+    label: &'static str,
+    port: u16,
+    category: &'static str,
+    adapter: &'static str,
+    note: &'static str,
+) -> KindMeta {
+    KindMeta {
+        id,
+        label,
+        port,
+        protocol: Protocol::Http,
+        category,
+        http: adapter,
+        driver: "",
+        note,
+        planned: false,
+    }
+}
+
+const fn native(
+    id: &'static str,
+    label: &'static str,
+    port: u16,
+    category: &'static str,
+    note: &'static str,
+) -> KindMeta {
+    KindMeta {
+        id,
+        label,
+        port,
+        protocol: Protocol::Native,
+        category,
+        http: "",
+        driver: "",
+        note,
+        planned: false,
+    }
+}
+
