-      const v = input.value;
-      const had = this.editingInput === input;
-      this.endEdit();
-      if (had) this.cb.onEditEnd?.(row, col, v === "" ? null : v); // 空串 = NULL
-    };
-    input.addEventListener("keydown", (e) => {
-      e.stopPropagation();
-      if (e.key === "Enter") {
-        e.preventDefault();
