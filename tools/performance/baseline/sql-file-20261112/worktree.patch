-                if pk > 0 {
-                    pk_idx.push((pk, name));
-                }
-            }
-            pk_idx.sort();
-            if !pk_idx.is_empty() {
-                let names: Vec<String> = pk_idx.into_iter().map(|(_, n)| n).collect();
-                indexes.push(IndexInfo {
-                    name: "PRIMARY KEY".into(),
-                    columns: names,
-                    unique: true,
-                    primary: true,
-                    method: None,
-                });
-            }
