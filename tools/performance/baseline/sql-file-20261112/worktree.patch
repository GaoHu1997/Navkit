-            if text.is_empty() {
-                Err(anyhow::anyhow!("视图不存在"))
-            } else {
-                Ok(text)
-            }
-        }
-        "sqlserver" | "mssql" => {
-            let (_, rows) = db
-                .generic_rows(&format!(
-                    "SELECT OBJECT_DEFINITION(OBJECT_ID('{}'))",
