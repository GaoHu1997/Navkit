-    // 通过 tbody 的 padding 模拟滚动偏移
-    this.tbody.style.paddingTop = `${first * ROW_HEIGHT}px`;
-    this.tbody.style.paddingBottom = `${Math.max(0, (total - last) * ROW_HEIGHT)}px`;
