-
-    if (this.opts.showRowNumbers !== false) {
-      const rowHeader = document.createElement("td");
-      rowHeader.className = "grid-row-header";
-      if (flag === "insert") {
-        rowHeader.classList.add("row-flag");
-        rowHeader.textContent = `+${r + 1}`;
-      } else if (flag === "delete") {
-        rowHeader.classList.add("row-flag");
-        rowHeader.textContent = `✕${r + 1}`;
-      } else if (flag === "dirty") {
-        rowHeader.classList.add("row-flag");
-        rowHeader.textContent = `●${r + 1}`;
-      } else {
