+/** 数据源徽章图标：圆角方块 + 标识字母。 */
+function kindBadgeIcon(color: string, id: string): IconDef {
+  const letters = (id.replace(/[^a-zA-Z0-9]/g, "").slice(0, 2) || "DB").toUpperCase();
+  return {
