+        assert!(validate_target_type("VARCHAR(", &pg).is_err());
+        assert!(validate_target_type("DECIMAL(10,99)", &mysql).is_err(), "MySQL 小数位上限 30");
+        assert!(validate_target_type("DATETIME(9)", &mysql).is_err(), "时间精度上限 6");
