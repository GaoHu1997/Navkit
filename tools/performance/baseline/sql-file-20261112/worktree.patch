+export interface ConstraintSet {
+  checks: ConstraintInfo[];
+  triggers: TriggerInfo[];
+  /** 缺省/unknown 不得视为完整空集合。 */
+  completeness?: "complete" | "partial" | "unknown";
+  limitations?: string[];
+  table_definition?: string | null;
+}
