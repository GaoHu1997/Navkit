+/** 新建备份向导：选择备份内容 → 备份选项 → 执行。 */
+
+import { api } from "../core/api";
+import type { ConnectionConfig } from "../core/types";
+import { Dialog, field, textInput } from "../ui/Dialog";
+import { iconSvgByName } from "../ui/icons";
+import { accessibleDialog } from "./SyncDialog";
+import { Wizard } from "../ui/Wizard";
+import { taskCenter } from "../core/backgroundTasks";
+
+/** 备份对象条目（勾选框 + 名称）。 */
+interface BackupItem {
+  name: string;
+  input: HTMLInputElement;
+}
+
+/** 一组勾选条目及其「全选 / 全不选」按钮。 */
+interface ItemBucket {
+  items: BackupItem[];
+  toggle: HTMLButtonElement;
+  /** 根行右侧的「已选 / 总数」。 */
+  count?: HTMLElement;
+  /** 空分组提示（根节点始终显示，没有子项时给出说明）。 */
+  empty?: HTMLElement;
+}
+
+/** 树形分组的 DOM 句柄：根行 + 子项容器。 */
+interface BackupGroup {
+  bucket: ItemBucket;
+  el: HTMLElement;
+  children: HTMLElement;
+  empty: HTMLElement;
+}
+
+let backupGroupSequence = 0;
+
+/** 备份文件名称不允许出现的字符（Windows 保留字符）。 */
+const FILE_NAME_INVALID = /[/\\:*?"<>|]/;
+
+/** 构造复选框行。 */
+function checkboxRow(labelText: string, checked: boolean): { label: HTMLLabelElement; input: HTMLInputElement } {
+  const label = document.createElement("label");
+  label.className = "checkbox";
+  const input = document.createElement("input");
+  input.type = "checkbox";
+  input.checked = checked;
+  input.setAttribute("aria-label", labelText);
+  const text = document.createElement("span");
+  text.textContent = labelText;
+  label.append(input, text);
+  return { label, input };
+}
+
+/** 只读展示输入框（执行步汇总）。 */
+function roInput(value: string): HTMLInputElement {
+  const input = textInput(value);
+  input.readOnly = true;
+  return input;
+}
+
+/** 打开「新建备份」向导。
+ *  onDone(rows, bytes) 在备份成功后回调（用于刷新备份列表与提示）。 */
+export function openBackupDialog(
+  connection: ConnectionConfig,
+  schema: string,
+  onDone: (rows: number, bytes: number) => void,
+): Dialog {
+  let wizard!: Wizard;
+  let running = false;
+  let loaded = false;
+
+  const tableBucket: ItemBucket = { items: [], toggle: document.createElement("button") };
+  const viewBucket: ItemBucket = { items: [], toggle: document.createElement("button") };
+  const routineBucket: ItemBucket = { items: [], toggle: document.createElement("button") };
+
+  // 执行步状态行
+  const status = document.createElement("div");
+  status.style.marginTop = "6px";
+  status.style.minHeight = "18px";
+  status.style.color = "var(--fg-muted)";
+
+  // 步1 对象列表加载状态行（加载中 / 失败提示）
+  const loadStatus = document.createElement("div");
+  loadStatus.style.marginTop = "6px";
+  loadStatus.style.color = "var(--fg-muted)";
+
+  /** 按「全不选 / 全选」刷新按钮文案（展示点击后将执行的动作）并同步计数。 */
+  function refreshToggle(bucket: ItemBucket): void {
+    const total = bucket.items.length;
+    const checked = bucket.items.filter((it) => it.input.checked).length;
+    if (bucket.count) bucket.count.textContent = total ? `${checked} / ${total}` : "0";
+    if (bucket.empty) bucket.empty.hidden = total > 0;
+    if (!total) {
+      bucket.toggle.hidden = true;
+      return;
+    }
+    bucket.toggle.hidden = false;
+    bucket.toggle.textContent = bucket.items.every((it) => it.input.checked) ? "全不选" : "全选";
+  }
+
+  /** 构造一个树形分组：根行始终显示（可折叠、可全选），叶子缩进一级。
+   *  即使某个分组没有对象，根节点也要出现，用户才能确认「这一类为空」。 */
+  function makeTreeGroup(title: string, icon: string, bucket: ItemBucket): BackupGroup {
+    const el = document.createElement("div");
+    el.className = "backup-tree-group";
+    el.setAttribute("role", "group");
+    el.setAttribute("aria-label", title);
+
+    const root = document.createElement("div");
