+    #[test] fn h2_null_and_unicode_preserved() { let r = decode_response(r#"{"columns":["中文"],"rows":[[null],["值;尾"]]}"#).unwrap(); assert_eq!(r.rows[0][0],None); assert_eq!(r.rows[1][0].as_deref(),Some("值;尾")); }
