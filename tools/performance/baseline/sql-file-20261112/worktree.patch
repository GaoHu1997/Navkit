+                    let receipt = crate::sql_history::query(&sql).execute(&mut *tx).await?;
+                    if script.counts_rows() { count = count.checked_add(receipt.rows_affected()).ok_or_else(|| anyhow!("导入影响行数溢出"))?; }
+                    statements += 1;
