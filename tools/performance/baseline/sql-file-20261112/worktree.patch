+            format!("SHOW {}.STABLES", container),
+            format!("SHOW {}.TABLES", container),
+        ] {
+            let r = self.sql(container, &q).await?;
+            for row in &r.rows {
+                if let Some(name) = row.first().cloned().flatten() {
+                    if !out.contains(&name) {
+                        out.push(name);
+                    }
+                }
+            }
+        }
+        Ok(out)
+    }
+    async fn rows(
+        &self,
+        container: &str,
