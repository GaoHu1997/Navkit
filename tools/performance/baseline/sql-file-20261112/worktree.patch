+    if (this.tableMode === "ddl") {
+      this.appendIdentity("info_pane_table", s.title, "表", meta);
+      this.appendModes();
+      const pre = document.createElement("pre");
+      pre.className = "ddl-code";
+      pre.innerHTML = highlightSql(s.ddl || "-- 无定义");
+      this.body.appendChild(pre);
