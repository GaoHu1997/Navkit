+        #[cfg(all(unix, not(target_os = "macos")))]
+        let prog = "xdg-open";
+        std::process::Command::new(prog)
+            .arg(&dir)
+            .spawn()
+            .map_err(|e| AppError::new(format!("无法打开文件夹: {}", e)))?;
