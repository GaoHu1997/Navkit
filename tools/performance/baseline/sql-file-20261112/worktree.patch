+      const failure = node("div", "drv-row-error");
+      failure.append(node("span", "drv-row-error-text", entry.error));
+      const retry = node("button", "btn sm", "重试");
+      retry.type = "button";
+      retry.addEventListener("click", () => {
+        activity.delete(key);
