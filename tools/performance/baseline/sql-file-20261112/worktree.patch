+    async fn containers(&self) -> Result<Vec<(String, String)>> {
+        let r = self.sql("", "SHOW DATABASES").await?;
+        Ok(r.rows
+            .iter()
+            .filter_map(|r| r.first().cloned().flatten())
+            .map(|n| (n.clone(), n))
+            .collect())
+    }
+    async fn objects(&self, container: &str) -> Result<Vec<String>> {
+        let mut out = Vec::new();
